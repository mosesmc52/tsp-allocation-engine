# AWS SES configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
FROM_ADDRESS=sender@example.com
TO_ADDRESSES=recipient@example.com,another-recipient@example.com
# Set to false to calculate positions without sending an email.
EMAIL_POSITIONS=true

# Optional runtime configuration
# Set to true to run outside the first seven days of the month.
FORCE_REBALANCE=false
# Optional local data directory for the cached TSP price history.
# TSP_DATA_DIR=portfolio/data
